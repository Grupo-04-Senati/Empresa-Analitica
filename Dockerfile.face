FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    libgtk-3-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements-face.txt .
RUN pip install --no-cache-dir -r requirements-face.txt

COPY backend/ .

EXPOSE 5000

CMD ["python", "face_start.py"]
